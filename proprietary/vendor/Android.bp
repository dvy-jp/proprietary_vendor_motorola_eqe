// Blobs Dolby del firmware stock A16 (.64R), declarados como prebuilt.
//
// Por que este archivo: el build NO acepta que se instalen librerias o
// ejecutables (archivos ELF) con PRODUCT_COPY_FILES; hay que declararlos como
// modulos. Se deja aca, al lado de los blobs, y no en el Android.bp generado
// del repo vendor, porque ese se regenera con extract-files.
//
// Las dependencias de cada modulo salen de leer las mismas librerias (readelf),
// asi que no estan puestas a mano ni de mas.



cc_prebuilt_library_shared {
    name: "libdmshal",
    owner: "motorola",
    // Blobs cerrados de Dolby del stock: se instalan sin revalidar su ELF.
    check_elf_files: false,
    strip: {
        none: true,
    },
    srcs: ["lib64/libdmshal.so"],
    shared_libs: [
        "vendor.dolby.dms-V1-ndk",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "libutils",
        "liblog",
        "libdapparamstorage",
        "libhidlbase",
        "vendor.dolby.hardware.dms@2.1",
        "vendor.dolby.hardware.dms@2.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    vendor: true,
    prefer: true,
    soc_specific: true,
}

