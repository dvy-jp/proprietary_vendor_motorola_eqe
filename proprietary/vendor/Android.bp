    shared_libs: [
        "libutils",
        "libstagefright_foundation",
        "liblog",
        "libxml2",
        "libcrypto",
        "libdapparamstorage",
        "libsqlite",
        "libcutils",
        "libc++",
        "libc",
        "libm",
